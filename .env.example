# ─────────────────────────────────────────────────────────────
# M-Pesa Analyzer Platform — Unified Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this template to .env before starting the stack:
#   cp .env.example .env

# ── Standard Production Ports ─────────────────────────────────
CI_ENVIRONMENT=production
HOST_BIND_IP=127.0.0.1
WEB_PORT=80
MYSQL_HOST_PORT=3306
REDIS_PORT=6379
ML_MPESA_ANALYZER_API_PORT=8001
ML_MPESA_ANALYZER_LLAMA_PORT=8080

# ── Shared Relational Database (MySQL 8.4) ────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=db_mpesa_analyzer
DB_USER=root
DB_PASSWORD=root_password
MYSQL_ROOT_PASSWORD=root_password

# ── WebApp & Mobile API Gateway (CodeIgniter 4) ───────────────
app.baseURL=http://localhost/
ML_BACKEND_URL=http://ml-mpesa-analyzer:9050

# Security Keys (16-byte keys for dynamic IV AES-128-CBC — matches Android app BuildConfig)
MPESA_CRYPT_KEY='a:r2yt>N3_\\Py,f='
MPESA_CRYPT_IV='[M[@_w[F4a>yQsJW'

# Default Superadmin Account (seeded on first boot)
SUPERADMIN_EMAIL=superadmin@mpesa-analyzer.local
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change_this_secure_password_123!

# ── ML Intelligence Microservice (FastAPI + llama.cpp) ────────
# Engine Selection: 'local' (llama-server) or 'external' (cloud API)
LLM_ENGINE=local
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen2.5-1.5b-instruct
MODEL_PATH=/models/qwen2.5-1.5b-instruct-q4_k_m.gguf

# Local LLM Context & Batch Tuning
LLM_CTX_SIZE=16384
LLM_BATCH_SIZE=512
N_GPU_LAYERS=0
BATCH_SIZE=5
POLL_INTERVAL=30
MAX_RETRIES=3

# Optional: External Cloud LLM Fallbacks (Groq, Gemini, DeepSeek, OpenAI)
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_PROVIDER=openai-compatible
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_API_KEY=

# Optional: Internal service secret for inter-service authentication
ML_INTERNAL_SECRET=

# ── Object Storage (MinIO / S3) ──────────────────────────────
STORAGE_DRIVER=minio
MINIO_ENDPOINT=http://minio:9000
# Browser-facing S3 endpoint (optional for pre-signed URLs, e.g. http://localhost:9000)
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=admin_mpesa
MINIO_ROOT_PASSWORD=change_this_minio_password_123!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_PAYLOADS=mpesa-payloads
MINIO_BUCKET_BACKUPS=mpesa-backups
MINIO_BUCKET_MODELS=mpesa-models
MINIO_BUCKET_EXPORTS=mpesa-exports
